{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZygoteRecordingManifest",
  "description": "Schema for trace.json recording manifests in Zygote spec/v1",
  "type": "object",
  "required": [
    "version",
    "hash_algorithm",
    "producer",
    "has_raw_prompts",
    "steps",
    "effects"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [1]
    },
    "hash_algorithm": {
      "type": "string",
      "enum": ["blake3", "sha256"]
    },
    "producer": {
      "type": "string"
    },
    "redaction_applied": {
      "type": "string"
    },
    "fidelity": {
      "type": "object",
      "required": ["tier"],
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["A", "B", "C"]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "has_raw_prompts": {
      "type": "boolean"
    },
    "meta": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "n",
          "name",
          "root",
          "effects"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "root": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "effects": {
            "type": "integer",
            "minimum": 0
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "seq",
          "op",
          "key",
          "value"
        ],
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 0
          },
          "op": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      }
    }
  }
}
